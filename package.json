{
  "name": "delbros-leasing-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Delbros Leasing — Client & Vendor Portal. External client and vendor self-service portal. React + Vite + Tailwind, light theme, no CDN, in-browser mock API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node scripts/check-no-cdn.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check:no-cdn": "node scripts/check-no-cdn.mjs",
    "changelog:md": "node scripts/changelog-md.mjs",
    "package:aws": "npm run typecheck && npm test && npm run build && node scripts/package-aws.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@hookform/resolvers": "^5.1.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "react-router": "^7.7.0",
    "signature_pad": "^5.0.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
